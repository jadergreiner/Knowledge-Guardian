{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-guardian.dev/schemas/finding/0.1.0/finding.schema.json",
  "title": "Knowledge Guardian Finding",
  "description": "Structured evidence-backed analysis result subject to human review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "id",
    "fingerprint",
    "rule_id",
    "type",
    "category",
    "title",
    "description",
    "authority",
    "subject",
    "evidence",
    "analysis",
    "impact",
    "confidence",
    "treatment",
    "recommendation",
    "review",
    "generated_at"
  ],
  "properties": {
    "contract": {
      "$ref": "#/$defs/contract"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Human-facing finding identifier."
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{16,64}$",
      "description": "Deterministic logical identity derived from rule, subject, location, authority, and observed condition."
    },
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": ["normative", "interpretative"]
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    },
    "impact": {
      "$ref": "#/$defs/impact"
    },
    "confidence": {
      "$ref": "#/$defs/confidence"
    },
    "treatment": {
      "$ref": "#/$defs/treatment"
    },
    "recommendation": {
      "$ref": "#/$defs/recommendation"
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1}
      }
    },
    "repository_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {"const": "interpretative"}
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "analysis": {
            "required": ["observation", "inference"]
          },
          "review": {
            "allOf": [
              {"$ref": "#/$defs/review"},
              {
                "properties": {
                  "required": {"const": true}
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "impact": {
            "properties": {
              "status": {"const": "unknown"}
            },
            "required": ["status"]
          }
        }
      },
      "then": {
        "properties": {
          "impact": {
            "required": ["reason"]
          }
        }
      }
    }
  ],
  "$defs": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "knowledge-guardian-finding"
        },
        "version": {
          "const": "0.1.0"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reference"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "native_rule",
            "project_profile",
            "formal_contract",
            "canonical_source"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope"],
      "properties": {
        "scope": {
          "type": "string",
          "enum": ["exact", "resource_level", "relationship_level", "not_available"]
        },
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "column_start": {"type": "integer", "minimum": 1},
        "column_end": {"type": "integer", "minimum": 1},
        "json_pointer": {"type": "string", "minLength": 1},
        "section": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {"const": "exact"}
            },
            "required": ["scope"]
          },
          "then": {
            "anyOf": [
              {"required": ["line_start"]},
              {"required": ["json_pointer"]},
              {"required": ["section"]}
            ]
          },
          "else": {
            "required": ["reason"]
          }
        }
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "location"],
      "properties": {
        "resource": {
          "type": "string",
          "minLength": 1
        },
        "resource_type": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "$ref": "#/$defs/location"
        }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "resource", "location", "observed"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "resource": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "observed": {},
        "expected": {},
        "excerpt": {
          "type": "string"
        },
        "snapshot_reference": {
          "type": "string"
        },
        "checksum": {
          "type": "string"
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation"],
      "properties": {
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "inference": {
          "$ref": "#/$defs/inference"
        }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "rationale"],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "level"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["known", "potential", "unknown", "not_applicable"]
        },
        "level": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low", "none", "unknown"]
        },
        "dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "engineering",
              "agent_behavior",
              "governance",
              "operational",
              "onboarding",
              "compliance",
              "product"
            ]
          }
        },
        "statement": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "affected_scope": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "rationale"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "recommended_action"],
      "properties": {
        "group": {
          "type": "string",
          "enum": [
            "confirmed_critical",
            "confirmed_actionable",
            "probable_risk",
            "investigative",
            "routine_improvement",
            "informational"
          ]
        },
        "recommended_action": {
          "type": "string",
          "enum": [
            "urgent_human_decision",
            "prioritize_remediation",
            "prioritized_human_review",
            "investigate",
            "add_to_backlog",
            "inform"
          ]
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "string"
        },
        "proposed_owner": {
          "type": "string"
        },
        "references": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status"],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending_review",
            "accepted",
            "revision_requested",
            "cancelled"
          ]
        },
        "reviewer": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
